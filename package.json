{
  "name": "ovm",
  "description": "Obsidian Vaults Manager",
  "type": "commonjs",
  "version": "0.7.0",
  "license": "GPL-3.0-only",
  "author": "Masoud Ghorbani",
  "homepage": "https://github.com/masoudgs/ovm",
  "bugs": "https://github.com/masoudgs/ovm/issues",
  "repository": "https://github.com/masoudgs/ovm.git",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.release.json",
    "build:watch": "rm -rf dist && tsc -p tsconfig.release.json -w",
    "build:release": "rm -rf dist && tsc -p tsconfig.release.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier -c \"**/*.{ts,json,md}\"",
    "format:write": "prettier -w \"**/*.{ts,json,md}\"",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "oclif manifest && pnpm run build:release && pnpm run test",
    "test": "pnpm vitest",
    "test:coverage": "pnpm run test --coverage",
    "prepare": "husky",
    "generate:schema": "ts-node src/scripts/json-schema-export.ts"
  },
  "keywords": [
    "obsidian",
    "vaults",
    "cli",
    "oclif"
  ],
  "bin": {
    "ovm": "./bin/run.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "oclif": {
    "bin": "ovm",
    "dirname": "ovm",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-version"
    ],
    "topicSeparator": " ",
    "topics": {
      "vaults": {
        "description": "Perform tasks on vaults"
      },
      "plugins": {
        "description": "Manage plugins of the vaults"
      },
      "reports": {
        "description": "Reports on vaults"
      }
    }
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@inquirer/core": "10.1.6",
    "@inquirer/prompts": "7.3.1",
    "@oclif/core": "4.2.6",
    "@oclif/plugin-help": "6.2.24",
    "@oclif/plugin-version": "^2.2.32",
    "async": "3.2.6",
    "date-fns": "4.1.0",
    "fast-folder-size": "2.4.0",
    "filesize": "10.1.6",
    "glob": "11.0.1",
    "inquirer": "12.4.1",
    "node-fetch-cache": "5.0.2",
    "obsidian-utils": "0.10.2",
    "winston": "3.17.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@oclif/prettier-config": "0.2.1",
    "@oclif/test": "4.1.9",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/async": "3.2.24",
    "@types/cacache": "17.0.2",
    "@types/fs-extra": "11.0.4",
    "@types/inquirer": "9.0.7",
    "@types/mock-fs": "4.13.4",
    "@types/node": "22.13.1",
    "@types/proxyquire": "1.3.31",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "eslint": "9.20.0",
    "eslint-config-prettier": "10.0.1",
    "fs-extra": "11.3.0",
    "globals": "15.14.0",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "obsidian": "1.7.2",
    "oclif": "4.17.25",
    "prettier": "3.4.2",
    "proxyquire": "2.1.3",
    "source-map-support": "0.5.21",
    "tap-junit": "^5.0.4",
    "ts-node": "10.9.2",
    "typescript": "5.5.4",
    "typescript-eslint": "8.23.0",
    "vitest": "^3.2.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser@<4.4.1": ">=4.5.1",
      "eslint>ajv": "6",
      "whatwg-url@<6.0.0": ">=14.1.0",
      "micromatch@<4.0.8": ">=4.0.8",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.6",
      "glob@<9.0.0": ">=11.0.1",
      "rimraf@<5.0.0": ">=6.0.1",
      "@babel/runtime@<7.26.10": ">=7.26.10",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
      "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2",
      "@eslint/plugin-kit@<0.3.4": ">=0.3.4",
      "tmp@<=0.2.3": ">=0.2.4",
      "vite@>=7.1.0 <=7.1.4": ">=7.1.5"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,json,js}": [
      "pnpm run lint",
      "pnpm run format:write"
    ],
    "*.md": [
      "pnpm run format:write"
    ]
  },
  "packageManager": "pnpm@10.16.0"
}
